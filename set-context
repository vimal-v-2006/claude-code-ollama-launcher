#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "This helper must run through pkexec or sudo." >&2
  exit 1
fi

context="${1:-}"
case "$context" in
  4096|8192|16384|32768|65536|131072) ;;
  *) echo "Unsupported context length: $context" >&2; exit 2 ;;
esac

unit="ollama.service"
dropin_dir="/etc/systemd/system/${unit}.d"
config="${dropin_dir}/90-claude-code-ollama-context.conf"
install -d -m 755 "$dropin_dir"
temporary="$(mktemp "${dropin_dir}/.context.XXXXXX")"
trap 'rm -f "$temporary"' EXIT
cat > "$temporary" <<EOF
[Service]
Environment="OLLAMA_CONTEXT_LENGTH=$context"
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
Environment="OLLAMA_KEEP_ALIVE=10m"
EOF
chmod 644 "$temporary"
mv -f "$temporary" "$config"
trap - EXIT
systemctl daemon-reload
systemctl restart "$unit"

for _ in $(seq 1 40); do
  if curl -fsS --max-time 1 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    echo "Ollama context set to $context"
    exit 0
  fi
  sleep 0.25
done

echo "Ollama did not become ready after restart" >&2
exit 1
